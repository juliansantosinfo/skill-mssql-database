# Copie para .env na raiz do projeto OU na raiz da skill (nunca versione .env)
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=meu_banco
MSSQL_USER=usuario_sql
MSSQL_PASSWORD=substituir_por_segredo

# auto: sqlcmd do host quando compatível; alternativa pyodbc
MSSQL_CLIENT=auto
# MSSQL_SQLCMD_PATH=C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\170\Tools\Binn\SQLCMD.EXE
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no
MSSQL_COMMAND_TIMEOUT=30

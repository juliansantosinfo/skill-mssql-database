# Copie para .env na raiz do projeto em execução (nunca versione .env com senhas reais)
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=meu_banco
MSSQL_USER=usuario_sql
MSSQL_PASSWORD=substituir_por_segredo

# Opcionais
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
# Defina 'yes' para Docker ou desenvolvimento local (certificado autoassinado); 'no' para produção com CA válida:
MSSQL_TRUST_SERVER_CERTIFICATE=no
MSSQL_COMMAND_TIMEOUT=30
